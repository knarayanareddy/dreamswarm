[0m[36m344[0m [0m[36m│[0m [0m[31mrustls 0.23.37 registry+https://github.com/rust-lang/crates.io-index[0m
    [0m[36m│[0m [0m[31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[0m [0m[31msecurity vulnerability detected[0m
